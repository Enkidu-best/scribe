#!/usr/bin/env bash
# git-хук pre-push (общий блок ci): перед отправкой на GitHub - scripts/check_all.sh; не прошло - push не уходит.
# Ставится common/ci/install.sh (в .git/hooks/pre-push - короткая ссылка сюда). Пропустить один раз: git push --no-verify.
ROOT="$(git rev-parse --show-toplevel)" || exit 1
send=0
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in *[!0]*) send=1 ;; esac   # одни нули - удаление ветки или метки на GitHub, проверять нечего
done
[ $send = 1 ] || exit 0
if [ ! -x "$ROOT/scripts/check_all.sh" ]; then
  echo "pre-push: нет scripts/check_all.sh - common/ci/install.sh" >&2
  exit 1
fi
echo "pre-push: проверка перед отправкой (scripts/check_all.sh; пропустить - git push --no-verify)" >&2
exec "$ROOT/scripts/check_all.sh" </dev/null >&2
